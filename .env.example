# ---------------------------------------------------------------------------
# Customer Journey Diagnostic - configuration
# Everything here is optional. With none of it set the diagnostic still runs
# end to end; it just won't take payment or send email.
# ---------------------------------------------------------------------------

# Public - inlined into the browser bundle at build time
# Prices shown on the two unlock options. Priced as the step down from the
# £6,000 sprint rather than as a cold impulse buy.
NEXT_PUBLIC_TIER_REPORT_PRICE=297
NEXT_PUBLIC_TIER_CALL_PRICE=497
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/tulivodigital/15min
NEXT_PUBLIC_CONTACT_EMAIL=jemina@tulivodigital.com
NEXT_PUBLIC_SITE_URL=tulivodigital.com
# Stan Store (or any external checkout). Used only when Stripe isn't configured.
NEXT_PUBLIC_CHECKOUT_URL=

# Stripe Checkout - set both to take payment on the results screen.
# Until Stripe (or NEXT_PUBLIC_CHECKOUT_URL) is set, the unlock button simply
# unlocks the report so the flow can be tested, and says so on the page.
STRIPE_SECRET_KEY=
# What each tier is actually charged, in pence.
DIAGNOSTIC_REPORT_PENCE=29700
DIAGNOSTIC_CALL_PENCE=49700

# Set to "true" to keep the report locked even with no payment method
# connected - i.e. no free unlocking, ever.
NEXT_PUBLIC_REQUIRE_PAYMENT=

# Manual unlock code, for anyone who paid via Stan Store, invoice or a call
DIAGNOSTIC_UNLOCK_CODE=

# Test mode on the live site. Set this to anything only you know, then visit
# /?test=<that value> to fill sample answers and unlock without paying.
# Local dev and Vercel preview deployments have test mode on already.
NEXT_PUBLIC_TEST_MODE_KEY=

# Email (Resend). The from address must be on a domain verified in Resend.
RESEND_API_KEY=
DIAGNOSTIC_FROM_EMAIL="Tulivo Digital <diagnostic@tulivodigital.com>"
DIAGNOSTIC_NOTIFY_EMAIL=jemina@tulivodigital.com

# ---------------------------------------------------------------------------
# Client links (/links) - for handing the diagnostic to people you've spoken to
# ---------------------------------------------------------------------------
# A long random string. Signs the links so they can't be forged or edited.
DIAGNOSTIC_LINK_SECRET=
# The key you type on /links to create one.
DIAGNOSTIC_ADMIN_KEY=

# ---------------------------------------------------------------------------
# Sign-in and usage limits
# ---------------------------------------------------------------------------
# Turn the gate on. With this false (or unset) the diagnostic is open to anyone.
DIAGNOSTIC_REQUIRE_LOGIN=false
# A long random string. Signs the session cookie and nothing else.
AUTH_SECRET=
# Where accounts and usage are stored. Required for the gate: without it, the
# limit can't be shared between visits and the gate refuses to let anyone in.
# A free Neon project is plenty (use the pooled connection string).
DATABASE_URL=
# How many diagnostics an account may run, and over what window.
DIAGNOSTIC_RUNS_PER_WINDOW=2
DIAGNOSTIC_WINDOW_DAYS=30
# The same numbers, for the wording on the sign-in screen.
NEXT_PUBLIC_RUNS_PER_WINDOW=2
NEXT_PUBLIC_WINDOW_DAYS=30
