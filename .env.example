# ---------------------------------------------------------------------------
# Customer Journey Diagnostic — configuration
# Everything here is optional. With none of it set the diagnostic still runs
# end to end; it just won't take payment or send email.
# ---------------------------------------------------------------------------

# Public — inlined into the browser bundle at build time
NEXT_PUBLIC_DIAGNOSTIC_PRICE=297
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/tulivodigital/15min
NEXT_PUBLIC_CONTACT_EMAIL=jemina@tulivodigital.com
NEXT_PUBLIC_SITE_URL=tulivodigital.com
# Stan Store (or any external checkout). Used only when Stripe isn't configured.
NEXT_PUBLIC_CHECKOUT_URL=

# Stripe Checkout — set both to take payment on the results screen
STRIPE_SECRET_KEY=
DIAGNOSTIC_PRICE_PENCE=29700

# Manual unlock code, for anyone who paid via Stan Store, invoice or a call
DIAGNOSTIC_UNLOCK_CODE=

# Email (Resend). The from address must be on a domain verified in Resend.
RESEND_API_KEY=
DIAGNOSTIC_FROM_EMAIL="Tulivo Digital <diagnostic@tulivodigital.com>"
DIAGNOSTIC_NOTIFY_EMAIL=jemina@tulivodigital.com
